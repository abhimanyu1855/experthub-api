# Copy to .env.production on the EC2 server (never commit real secrets).
# Replace 54-123-45-67 with your Elastic IP (dots → dashes for nip.io).

POSTGRES_PASSWORD=change_me_strong_password

RAILS_ENV=production
RAILS_MASTER_KEY=
DEVISE_JWT_SECRET_KEY=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

APP_DOMAIN=54-123-45-67.nip.io
FRONTEND_URL=http://54-123-45-67.nip.io
CORS_EXTRA_ORIGINS=http://54-123-45-67.nip.io,http://sosmydoctor.54-123-45-67.nip.io

FORCE_SSL=false
SOLID_QUEUE_IN_PUMA=false
SOLID_CACHE=false
PGSSLMODE=disable

# Optional — leave blank for initial testing
SMTP_PASSWORD=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
