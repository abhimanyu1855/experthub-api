# .kamal/secrets.example
# Copy to .kamal/secrets and fill in real values.
# This file is safe to commit. .kamal/secrets is gitignored.
#
# Kamal reads these as shell exports and injects them as Docker secrets.
# Reference: https://kamal-deploy.org/docs/configuration/environment-variables/#secrets

# Docker registry password (Docker Hub token, GHCR PAT, etc.)
KAMAL_REGISTRY_PASSWORD=your-registry-password-or-token

# Rails master key (cat config/master.key)
RAILS_MASTER_KEY=your-master-key-here

# Database
DATABASE_URL=postgresql://experthub:CHANGE_ME@1.2.3.4:5432/experthub_production
QUEUE_DATABASE_URL=postgresql://experthub:CHANGE_ME@1.2.3.4:5432/experthub_queue_production
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://1.2.3.4:6379/0

# Auth (generate: bin/rails secret)
DEVISE_JWT_SECRET_KEY=generate_with_bin_rails_secret

# Active Record Encryption (generate: bin/rails db:encryption:init)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Email
SMTP_PASSWORD=your-smtp-password
MAILER_FROM=ExpertHub <noreply@experthub.app>

# Stripe (platform account — for billing marketplace operators)
STRIPE_SECRET_KEY=sk_live_xxx
PLATFORM_STRIPE_SECRET_KEY=sk_live_xxx
PLATFORM_STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# Video
DAILY_API_KEY=xxx

# Monitoring
SENTRY_DSN=https://xxx@sentry.io/xxx

# CORS — comma-separated list of allowed frontend origins
CORS_EXTRA_ORIGINS=https://experthub.app,https://www.experthub.app
